{
  "name": "@game-agent/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "sync:projects": "node scripts/sync-projects.ts",
    "sync:notices": "node scripts/check-notices.ts --write",
    "check:boundaries": "node scripts/check-boundaries.ts && node scripts/sync-projects.ts --check",
    "check:headers": "node scripts/check-headers.ts",
    "check:notices": "node scripts/check-notices.ts",
    "check:smoke": "node scripts/check-smoke.ts",
    "check:conventions": "node scripts/check-conventions.ts",
    "check": "pnpm build && pnpm test && pnpm check:boundaries && pnpm check:headers && pnpm check:notices && pnpm check:smoke",
    "game-agent": "node apps/cli/lib/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
