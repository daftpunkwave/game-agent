{
  "name": "@game-agent/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "check:headers": "node scripts/check-headers.ts",
    "check:notices": "node scripts/check-notices.ts",
    "check:smoke": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/check-smoke.ts",
    "check:conventions": "node scripts/check-conventions.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm check:headers && pnpm check:notices && pnpm check:smoke",
    "game-agent": "node --experimental-transform-types --disable-warning=ExperimentalWarning apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
