{
  "name": "@game-agent/credentials-local",
  "version": "0.0.0",
  "private": true,
  "description": "File-backed credentials provider ($GAME_AGENT_HOME/.env under the live process environment)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/schema": "workspace:*",
    "chokidar": "5.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@game-agent/atomic-write": "workspace:*",
    "@game-agent/credentials": "workspace:*",
    "@game-agent/home-paths": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/launch-environment": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/atomic-write": "workspace:*",
    "@game-agent/credentials": "workspace:*",
    "@game-agent/home-paths": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/launch-environment": "workspace:*"
  }
}
