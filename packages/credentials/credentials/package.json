{
  "name": "@game-agent/credentials",
  "version": "0.0.0",
  "private": true,
  "description": "Abstract credential seam (ctx.credentials): settings carry references to secrets, providers own the values",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/launch-environment": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/launch-environment": "workspace:*"
  }
}
