{
  "name": "@game-agent/util-ripgrep",
  "version": "0.0.0",
  "private": true,
  "description": "Packaged ripgrep resolution and subprocess streaming helpers",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
