{
  "name": "@game-agent/native-system",
  "version": "0.0.0",
  "private": true,
  "description": "Native system helpers: the Linux Landlock launcher locator and exclusive POSIX file locks through the C library",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./landlock-run": {
      "@game-agent/source": "./src/landlock-run.ts",
      "types": "./lib/landlock-run.d.ts",
      "default": "./lib/landlock-run.js"
    },
    "./flock": {
      "@game-agent/source": "./src/flock.ts",
      "types": "./lib/flock.d.ts",
      "default": "./lib/flock.js"
    }
  },
  "dependencies": {
    "koffi": "3.1.1"
  }
}
