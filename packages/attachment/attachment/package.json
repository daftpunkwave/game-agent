{
  "name": "@game-agent/attachment",
  "version": "0.0.0",
  "private": true,
  "description": "Durable immutable attachment storage seam",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@game-agent/error": "workspace:*",
    "@game-agent/kernel": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/brand": "workspace:*",
    "@game-agent/error": "workspace:*",
    "@game-agent/kernel": "workspace:*"
  }
}
