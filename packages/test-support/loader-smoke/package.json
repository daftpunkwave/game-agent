{
  "name": "@game-agent/loader-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "Shared subprocess and direct-agent runtime for keyless real-Loader example smoke tests",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "execa": "^10.0.1",
    "tsx": "^4.23.13"
  },
  "peerDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/http-proxy": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/app-boot": "workspace:*",
    "@game-agent/brand": "workspace:*",
    "@game-agent/http-proxy": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/tools": "workspace:*"
  }
}
