{
  "name": "@game-agent/agent-loop-testkit",
  "version": "0.0.0",
  "private": true,
  "description": "Prerequisite mounting, production AgentLoop drivers, and Inbox stubs for tests",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
