{
  "name": "@game-agent/agent-preset-registry",
  "version": "0.0.0",
  "private": true,
  "description": "Declarative Agent preset registry and profile-backed editing",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./display": {
      "@game-agent/source": "./src/display.ts",
      "types": "./lib/display.d.ts",
      "default": "./lib/display.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/app-boot": "workspace:*",
    "@game-agent/schema": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "@game-agent/scope": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/settings": "workspace:*",
    "@game-agent/system-prompt": "workspace:*",
    "@game-agent/tools": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/agent-loop": "workspace:*",
    "@game-agent/agent-preset": "workspace:*",
    "@game-agent/atomic-write": "workspace:*",
    "@game-agent/brand": "workspace:*",
    "@game-agent/fs-local": "workspace:*",
    "@game-agent/hmr": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-group": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/ptc-runtime": "workspace:*",
    "@game-agent/sandbox": "workspace:*",
    "@game-agent/sandbox-policy": "workspace:*",
    "@game-agent/scope": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/settings": "workspace:*",
    "@game-agent/system-prompt": "workspace:*",
    "@game-agent/tool-executor-native": "workspace:*",
    "@game-agent/tool-executor-ptc": "workspace:*",
    "@game-agent/tool-testkit": "workspace:*",
    "@game-agent/tools": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*",
    "@game-agent/user-approval": "workspace:*",
    "@game-agent/working-directory": "workspace:*"
  }
}
