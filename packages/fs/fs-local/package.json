{
  "name": "@game-agent/fs-local",
  "version": "0.0.0",
  "private": true,
  "description": "Local-filesystem implementation of the game-agent filesystem seam (ctx.fs)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*",
    "@game-agent/fs-patch": "workspace:*",
    "@game-agent/schema": "workspace:*",
    "chokidar": "5.0.0",
    "koffi": "3.1.1"
  },
  "peerDependencies": {
    "@game-agent/fs": "workspace:*",
    "@game-agent/kernel": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/fs": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*"
  }
}
