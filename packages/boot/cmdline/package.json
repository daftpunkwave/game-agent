{
  "name": "@game-agent/cmdline",
  "version": "0.0.0",
  "private": true,
  "description": "Immutable command-line handoff from a game-agent launcher to any app plugin that injects cmdlineArgs",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "commander": "^15.0.0"
  }
}
