{
  "name": "@game-agent/config-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/atomic-write": "workspace:*",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@game-agent/app-boot": "workspace:*",
    "@game-agent/hmr": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@game-agent/hmr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@game-agent/app-boot": "workspace:*",
    "@game-agent/hmr": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*"
  }
}
