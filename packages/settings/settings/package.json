{
  "name": "@game-agent/settings",
  "version": "0.0.0",
  "private": true,
  "description": "Abstract user-settings seam (ctx.settings)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/config-editor": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "@game-agent/kit": "workspace:*",
    "@game-agent/util-values": "workspace:*",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@game-agent/brand": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/schema": "workspace:*",
    "@game-agent/session": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/agent-default-model": "workspace:*",
    "@game-agent/app-boot": "workspace:*",
    "@game-agent/brand": "workspace:*",
    "@game-agent/hmr": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-timer": "workspace:*",
    "@game-agent/schema": "workspace:*",
    "@game-agent/session": "workspace:*",
    "yaml": "^2.8.1"
  }
}
