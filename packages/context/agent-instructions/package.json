{
  "name": "@game-agent/agent-instructions",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/schema": "workspace:*",
    "@game-agent/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/fs": "workspace:*",
    "@game-agent/home-paths": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/tools": "workspace:*",
    "@game-agent/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/agent-loop": "workspace:*",
    "@game-agent/agent-loop-testkit": "workspace:*",
    "@game-agent/brand": "workspace:*",
    "@game-agent/fs": "workspace:*",
    "@game-agent/fs-local": "workspace:*",
    "@game-agent/home-paths": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/system-prompt": "workspace:*",
    "@game-agent/tool-executor-native": "workspace:*",
    "@game-agent/tool-fs": "workspace:*",
    "@game-agent/tool-testkit": "workspace:*",
    "@game-agent/tools": "workspace:*",
    "@game-agent/working-directory": "workspace:*"
  }
}
