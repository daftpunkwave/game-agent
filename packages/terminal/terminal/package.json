{
  "name": "@game-agent/terminal",
  "version": "0.0.0",
  "private": true,
  "description": "Persistent PTY session seam — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*"
  },
  "peerDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/error": "workspace:*",
    "@game-agent/kernel": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/agent-loop-testkit": "workspace:*",
    "@game-agent/error": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*"
  }
}
