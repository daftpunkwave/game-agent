{
  "name": "@game-agent/sandbox-windows-acl",
  "version": "0.0.0",
  "private": true,
  "description": "Windows ACL write-restriction sandbox backend (restricted-token spawn with capability-SID write allowlist) for the game-agent sandbox seam",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "@game-agent/source": "./src/runner.ts",
      "types": "./lib/runner.d.ts",
      "default": "./lib/runner.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@game-agent/lazy-require": "workspace:*",
    "@game-agent/win32-process": "workspace:*",
    "koffi": "3.1.1",
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/skill": "workspace:*",
    "@game-agent/subprocess": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "@game-agent/pwsh-local": "workspace:*",
    "@game-agent/sandbox": "workspace:*",
    "@game-agent/sandbox-local": "workspace:*",
    "@game-agent/skill": "workspace:*",
    "@game-agent/subprocess": "workspace:*",
    "@game-agent/subprocess-local": "workspace:*"
  }
}
