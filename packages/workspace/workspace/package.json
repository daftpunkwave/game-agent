{
  "name": "@game-agent/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace entity registry (ctx.workspaceRegistry): durable workspace records with validated session attachment over the domain data form",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-persistence": "workspace:*",
    "@game-agent/storage": "workspace:*",
    "@game-agent/storage-domain": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-persistence": "workspace:*",
    "@game-agent/storage": "workspace:*",
    "@game-agent/storage-domain": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*"
  }
}
