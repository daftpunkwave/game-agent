{
  "name": "@game-agent/storage",
  "version": "0.0.0",
  "private": true,
  "description": "Storage hub (ctx.storage): named backend registry plus mounted data-form facilities",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/kernel": "workspace:*"
  }
}
