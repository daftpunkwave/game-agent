{
  "name": "@game-agent/bash-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Sandbox-consuming implementation of the game-agent bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@game-agent/bash-local": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/sandbox": "workspace:*",
    "@game-agent/sandbox-policy": "workspace:*",
    "@game-agent/shell": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/bash-local": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/native-system": "workspace:*",
    "@game-agent/sandbox": "workspace:*",
    "@game-agent/sandbox-local": "workspace:*",
    "@game-agent/sandbox-policy": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/shell": "workspace:*",
    "@game-agent/subprocess": "workspace:*",
    "@game-agent/subprocess-local": "workspace:*"
  }
}
