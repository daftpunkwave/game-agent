{
  "name": "@game-agent/compaction-tool-result-pruner",
  "version": "0.0.0",
  "private": true,
  "description": "Replay-safe model-free head/middle/tail pruning for tool-result surface nodes",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/schema": "workspace:*",
    "@game-agent/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@game-agent/compaction": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/token-meter": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/brand": "workspace:*",
    "@game-agent/compaction": "workspace:*",
    "@game-agent/compaction-image-offload": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/token-meter": "workspace:*"
  }
}
