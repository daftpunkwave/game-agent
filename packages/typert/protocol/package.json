{
  "name": "@game-agent/typert-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Compiler-independent Remote metadata and Typert provider protocols",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./remote-info": {
      "@game-agent/source": "./src/remote-info.ts",
      "types": "./lib/remote-info.d.ts",
      "default": "./lib/remote-info.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    }
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@game-agent/error": "workspace:*",
    "@game-agent/kernel": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/error": "workspace:*",
    "@game-agent/kernel": "workspace:*"
  }
}
