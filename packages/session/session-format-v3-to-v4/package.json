{
  "name": "@game-agent/session-format-v3-to-v4",
  "version": "0.0.0",
  "private": true,
  "description": "Streaming tool-role migration and delivery validation from Session V3 to V4",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
