{
  "name": "@game-agent/session-persistence-jsonl",
  "version": "0.0.0",
  "private": true,
  "description": "JSONL durable session persistence backend",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/native-system": "workspace:*",
    "@game-agent/schema": "workspace:*",
    "@game-agent/session-format": "workspace:*",
    "@game-agent/session-format-catalog": "workspace:*",
    "@game-agent/session-format-v3-to-v4": "workspace:*",
    "koffi": "3.1.1",
    "p-limit": "7.3.3"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-persistence": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-format-v0-to-v1": "workspace:*",
    "@game-agent/session-format-v1-to-v2": "workspace:*",
    "@game-agent/session-persistence": "workspace:*",
    "@game-agent/session-persistence-sqlite": "workspace:*"
  }
}
