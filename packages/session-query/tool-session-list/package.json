{
  "name": "@game-agent/tool-session-list",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only paginated Workspace and Session metadata tools",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/session-projection-cache": "workspace:*",
    "@game-agent/session-query": "workspace:*",
    "@game-agent/session-title": "workspace:*",
    "@game-agent/tools": "workspace:*",
    "@game-agent/workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@game-agent/session-projection-cache": {
      "optional": true
    },
    "@game-agent/session-title": {
      "optional": true
    }
  },
  "devDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-persistence": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/session-projection-cache": "workspace:*",
    "@game-agent/session-query": "workspace:*",
    "@game-agent/session-title": "workspace:*",
    "@game-agent/storage": "workspace:*",
    "@game-agent/storage-domain": "workspace:*",
    "@game-agent/storage-json": "workspace:*",
    "@game-agent/system-prompt": "workspace:*",
    "@game-agent/tool-executor-native": "workspace:*",
    "@game-agent/tool-testkit": "workspace:*",
    "@game-agent/tools": "workspace:*",
    "@game-agent/workspace": "workspace:*"
  }
}
