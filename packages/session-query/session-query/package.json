{
  "name": "@game-agent/session-query",
  "version": "0.0.0",
  "private": true,
  "description": "Combined session query service contract with concrete reads, traces, and filters",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@game-agent/session-format-catalog": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-persistence": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/session-projection-cache": "workspace:*",
    "@game-agent/session-title": "workspace:*",
    "@game-agent/tool-todo": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@game-agent/session-persistence": {
      "optional": true
    },
    "@game-agent/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@game-agent/brand": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-persistence": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/session-projection-cache": "workspace:*",
    "@game-agent/session-title": "workspace:*",
    "@game-agent/tool-todo": "workspace:*"
  }
}
