{
  "name": "@game-agent/session",
  "version": "0.0.0",
  "private": true,
  "description": "Event-sourced session store",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./fork": {
      "@game-agent/source": "./src/fork.ts",
      "types": "./lib/fork.d.ts",
      "default": "./lib/fork.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./surface": {
      "@game-agent/source": "./src/surface.ts",
      "types": "./lib/surface.d.ts",
      "default": "./lib/surface.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/scope": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/scope": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*",
    "@game-agent/typert-registry": "workspace:*"
  }
}
