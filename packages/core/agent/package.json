{
  "name": "@game-agent/agent",
  "version": "0.0.0",
  "private": true,
  "description": "Agent interface, registry, initiator scope, and event vocabulary",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/scope": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/system-prompt": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*",
    "@game-agent/util-values": "workspace:*",
    "@game-agent/workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@game-agent/workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/scope": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/system-prompt": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*",
    "@game-agent/typert-registry": "workspace:*",
    "@game-agent/util-values": "workspace:*",
    "@game-agent/workspace": "workspace:*"
  }
}
