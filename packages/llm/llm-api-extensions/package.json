{
  "name": "@game-agent/llm-api-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Additive request-field registry for provider LLM API adapters",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@game-agent/kernel": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/kernel": "workspace:*"
  }
}
