{
  "name": "@game-agent/llm",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-neutral LLM service interface",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./message": {
      "@game-agent/source": "./src/message.ts",
      "types": "./lib/message.d.ts",
      "default": "./lib/message.js"
    },
    "./assistant-stream": {
      "@game-agent/source": "./src/assistant-stream.ts",
      "types": "./lib/assistant-stream.d.ts",
      "default": "./lib/assistant-stream.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*",
    "@game-agent/schema": "workspace:*",
    "@game-agent/timeout": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*",
    "@game-agent/util-crypto": "workspace:*",
    "@game-agent/util-values": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@game-agent/error": "workspace:*",
    "@game-agent/kernel": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/attachment": "workspace:*",
    "@game-agent/error": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/package-manifest": "workspace:*"
  }
}
