{
  "name": "@game-agent/token-meter",
  "version": "0.0.0",
  "private": true,
  "description": "Replay-aware token measurement service (ctx.tokenMeter)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "@game-agent/source": "./src/client.ts",
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./estimate": {
      "@game-agent/source": "./src/estimate.ts",
      "types": "./lib/estimate.d.ts",
      "default": "./lib/estimate.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/schema": "workspace:*",
    "@game-agent/util-values": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@game-agent/compaction": "workspace:*",
    "@game-agent/compaction-image-offload": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/llm-retry": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/attachment": "workspace:*",
    "@game-agent/brand": "workspace:*",
    "@game-agent/compaction": "workspace:*",
    "@game-agent/compaction-image-offload": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/llm-retry": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*"
  }
}
