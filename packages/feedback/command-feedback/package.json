{
  "name": "@game-agent/command-feedback",
  "version": "0.0.0",
  "private": true,
  "description": "Log-only session feedback: the record event, the sessionFeedback Host Remote, and the human-facing slash command",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "@game-agent/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "@game-agent/source": "./src/types.ts",
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": {
      "@game-agent/source": "./src/*"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@game-agent/brand": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@game-agent/anonymous-user-id": "workspace:*",
    "@game-agent/commands": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@game-agent/agent": "workspace:*",
    "@game-agent/agent-loop-testkit": "workspace:*",
    "@game-agent/anonymous-user-id": "workspace:*",
    "@game-agent/commands": "workspace:*",
    "@game-agent/kernel": "workspace:*",
    "@game-agent/kernel-include": "workspace:*",
    "@game-agent/kernel-loader": "workspace:*",
    "@game-agent/llm": "workspace:*",
    "@game-agent/session": "workspace:*",
    "@game-agent/session-projection": "workspace:*",
    "@game-agent/typert-protocol": "workspace:*"
  }
}
